{
  "_meta": {
    "purpose": "Clock-time format normalization coverage for the Katala temporal parser.",
    "reference_now": "2026-08-17T14:00:00+08:00",
    "reference_now_note": "Monday, 2:00 PM Asia/Manila. All relative resolutions assume this instant.",
    "default_rules_under_test": [
      "Bare hour with no meridiem resolves to the NEXT occurrence of that hour.",
      "12am = 00:00 (midnight), 12pm = 12:00 (noon).",
      "A time already past today rolls to tomorrow unless a date is stated.",
      "Invalid times must fail gracefully: valid=false, no crash, no silent clamping."
    ],
    "normalized_fields": {
      "time_24h": "HH:MM in 24-hour form, or null if unresolvable",
      "end_time_24h": "HH:MM for ranges, else null",
      "date_offset": "today | tomorrow | explicit date string | null",
      "meridiem_ambiguous": "true when the input gave no AM/PM and the parser had to infer",
      "valid": "false when the input is not a resolvable time"
    }
  },
  "cases": [
